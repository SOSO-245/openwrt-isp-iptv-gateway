#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    [ -s /etc/iptv-discovery.json ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/iptv-discovery/router.py
    procd_set_param respawn 3600 30 3
    procd_set_param term_timeout 15
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
